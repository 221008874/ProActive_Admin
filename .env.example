# Firebase web app config for this project.
# Copy this file to ".env" and fill in the values from:
#   Firebase console -> Project settings -> Your apps -> SDK setup and configuration -> Config
#
# These are public client values (they ship in the browser bundle either way);
# they are kept out of source control only so the project can be swapped
# without touching source. Only VITE_-prefixed vars are exposed to the client.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Base URL of the deployed ProActive_Store app, e.g.
#   https://pro-active-store.vercel.app
# The Bills tab fetches generated tax invoices from the store's
# admin-authenticated download endpoint (the bytes live in a private GitHub
# repository on the store side and have no public URL). Without this value the
# bills list loads but View/Download shows a "not configured" notice.
VITE_STORE_API_BASE=